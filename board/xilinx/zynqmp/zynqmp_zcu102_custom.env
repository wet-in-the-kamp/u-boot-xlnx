custom_boot=echo Attempting network boot...;
	    if dhcp && tftp ${pxefile_addr_r} images/pl.bin && fpga load 0 ${pxefile_addr_r} $filesize &&
	       tftp ${kernel_addr_r} images/Image && tftp ${fdt_addr_r} images/system.dtb &&
	       tftp ${ramdisk_addr_r} images/rootfs.cpio && booti ${kernel_addr_r} ${ramdisk_addr_r}:${filesize} ${fdt_addr_r};
	    then true;
	    else echo Network boot failed or files not found - falling back to default boot method...;
	       run distro_bootcmd; fi
